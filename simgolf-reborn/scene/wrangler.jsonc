{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simgolfer",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "simgolfer.0x4d.in",
      "custom_domain": true
    }
  ],
  "main": "server/worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ORIGIN": "https://simgolfer.0x4d.in"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simgolfer-accounts",
      "database_id": "c75a5302-f11d-4786-9221-1debc7991753",
      "migrations_dir": "server/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
