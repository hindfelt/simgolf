{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fairway-baron-multiplayer-review",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [],
  "main": "server/worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ORIGIN": "https://fairway-baron-multiplayer-review.hindfelt.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairway-baron-multiplayer-review",
      "database_id": "6bed7168-c1ef-4891-8d46-5741f6c744b6",
      "migrations_dir": "server/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COURSE_SCHEDULERS",
        "class_name": "CourseScheduler"
      },
      {
        "name": "TOURNAMENT_ROUNDS",
        "class_name": "TournamentRoundHost"
      },
      {
        "name": "TOURNAMENT_SCHEDULERS",
        "class_name": "TournamentScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "shared-course-scheduler-v1",
      "new_sqlite_classes": [
        "CourseScheduler"
      ]
    },
    {
      "tag": "tournament-round-host-v1",
      "new_sqlite_classes": [
        "TournamentRoundHost"
      ]
    },
    {
      "tag": "tournament-scheduler-v1",
      "new_sqlite_classes": [
        "TournamentScheduler"
      ]
    }
  ]
}
